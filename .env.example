# Antigravity uses the account you sign into with agy. No password is stored here.
AI_PROVIDER=antigravity
# Leave blank to use the current Antigravity default. Use `agy models` for IDs.
AI_MODEL=
AGY_PATH=agy
PORT=4310
# Optional alternative: direct Gemini video analysis (API quota is separate).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Official OAuth access tokens. Never commit .env. Tokens expire; replace as needed.
YOUTUBE_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# facebook: Meta Page token + linked Instagram professional account ID,
# with direct local video transfer. instagram: Instagram Login + public media URL.
INSTAGRAM_LOGIN=instagram
META_API_VERSION=v27.0
# Instagram must fetch exported videos from an HTTPS host you control.
# Upload each export there yourself with the same /job-id/clip-id.mp4 path.
PUBLIC_MEDIA_BASE_URL=
